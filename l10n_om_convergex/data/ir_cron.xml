<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Active by default: safe to run even before ConvergeX credentials are configured, since
         _cron_poll_status degrades to a no-op for companies without a Client ID/Secret set. -->
    <record id="ir_cron_l10n_om_convergex_poll_status" model="ir.cron">
        <field name="name">ConvergeX: Poll Submission Status</field>
        <field name="model_id" ref="model_l10n_om_convergex_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
