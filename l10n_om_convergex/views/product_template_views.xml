<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_l10n_om_convergex" model="ir.ui.view">
        <field name="name">product.template.form.inherit.l10n_om_convergex</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']/group[@name='accounting']" position="inside">
                <group string="Oman E-Invoicing (ConvergeX)" name="l10n_om_convergex">
                    <field name="l10n_om_hs_code" placeholder="12-digit HS Code (IBT-158)"/>
                    <field name="l10n_om_isic_code" placeholder="6-digit ISIC Code (BTOM-033)"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
